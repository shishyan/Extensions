{
  "manifest_version": 3,
  "name": "OctoTree \u2014 Free Left-Docked IDE File Tree & Code/Heading Navigator",
  "short_name": "OctoTree",
  "version": "1.0.0",
  "description": "100% Free Octotree Pro alternative: Left-docked IDE file tree sidebar for GitHub & technical docs, instant filename filter &...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OctoTree \u2014 IDE File Tree & Code Navigator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "octotree@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}