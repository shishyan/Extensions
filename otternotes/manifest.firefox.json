{
  "manifest_version": 3,
  "name": "OtterNotes \u2014 Free Live Meeting Caption Recorder & Action-Item Minutes",
  "short_name": "OtterNotes",
  "version": "1.0.0",
  "description": "100% Free Otter.ai Pro alternative: Live meeting caption & transcript recorder (Google Meet, Zoom, YouTube), Action-Item...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OtterNotes \u2014 Free Meeting Transcript & Action-Item Recorder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "otternotes@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}