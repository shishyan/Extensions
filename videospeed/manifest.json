{
  "manifest_version": 3,
  "name": "VideoSpeed \u2014 0.1x\u201316x HTML5 Speed Controller, PiP & A-B Loop",
  "version": "1.0.0",
  "description": "Precision 0.1x\u201316x HTML5 video speed controller, Picture-in-Picture launcher, A-B segment looper & PNG frame capture.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}