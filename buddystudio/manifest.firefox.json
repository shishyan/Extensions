{
  "manifest_version": 3,
  "name": "BuddyStudio \u2014 Free YouTube A/B Title CTR Tester, Canned Replies & Launch Checklist",
  "short_name": "BuddyStudio",
  "version": "1.0.0",
  "description": "100% Free TubeBuddy Legend alternative: A/B Title CTR scorer, 1-click canned comment reply templates, tag deduplicator &...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BuddyStudio \u2014 YouTube A/B Title Tester & Creator Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "buddystudio@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}