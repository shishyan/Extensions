{
  "manifest_version": 3,
  "name": "BitPass \u2014 Password & Passphrase Generator + TOTP 2FA Vault",
  "version": "1.0.0",
  "description": "Cryptographic password & BIP-39 passphrase generator, built-in RFC-6238 TOTP 2FA authenticator & local autofill vault.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bitpass@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}