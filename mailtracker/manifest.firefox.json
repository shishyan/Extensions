{
  "manifest_version": 3,
  "name": "MailTracker \u2014 Free Zero-Watermark Email Open/Click Tracker & Subject Scorer",
  "short_name": "MailTracker",
  "version": "1.0.0",
  "description": "100% Free Mailtrack Pro alternative: Zero-watermark email follow-up tracker, subject-line open-rate scorer (0-100%) & 1-click UTM link click builder.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MailTracker \u2014 Zero-Watermark Email Tracker & Subject Scorer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mailtracker@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}
