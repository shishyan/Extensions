{
  "manifest_version": 3,
  "name": "TodoistTask \u2014 Free 1-Click Webpage-to-Task Clipper & Priority Manager",
  "short_name": "TodoistTask",
  "version": "1.0.0",
  "description": "100% Free Todoist Pro Web Clipper alternative: 1-click webpage/selection-to-task clipper, Priority P1-P4 tags, due dates &...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TodoistTask \u2014 Webpage Task Clipper & Priority Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}