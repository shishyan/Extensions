{
  "manifest_version": 3,
  "name": "WhatFont \u2014 Free Hover Typography Inspector & Live Font-Pairing Tester",
  "short_name": "WhatFont",
  "version": "1.0.0",
  "description": "100% Free WhatFont & Fonts Ninja Pro alternative: Hover typography inspector (family, size, weight, line-height) + 1-click live Google Font pairing tester.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatFont \u2014 Typography Inspector & Live Font Tester",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
