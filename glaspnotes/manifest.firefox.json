{
  "manifest_version": 3,
  "name": "GlaspNotes \u2014 Free Web Highlighter, Margin Note Taker & Markdown Exporter",
  "short_name": "GlaspNotes",
  "version": "1.0.0",
  "description": "100% Free Glasp Pro alternative: 4-color floating web & article highlighter, inline margin notes, persistent quote restorer &...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GlaspNotes \u2014 Web Highlighter & Markdown Knowledge Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "glaspnotes@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}