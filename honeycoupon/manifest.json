{
  "manifest_version": 3,
  "name": "HoneyCoupon \u2014 Free Zero-Tracking Auto-Coupon Applier & Discount Calculator",
  "short_name": "HoneyCoupon",
  "version": "1.0.0",
  "description": "100% Free PayPal Honey & CapitalOne Shopping alternative: Zero-tracking checkout coupon detector, automatic promo code tester & best-discount calculator.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HoneyCoupon \u2014 Auto-Coupon Applier & Discount Finder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
