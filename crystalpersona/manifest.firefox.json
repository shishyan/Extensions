{
  "manifest_version": 3,
  "name": "CrystalPersona \u2014 Free DISC Buyer Personality Analyzer & Pitch Coach",
  "short_name": "CrystalPersona",
  "version": "1.0.0",
  "description": "100% Free Crystal Knows Premium alternative: Real-time DISC buyer personality analyzer (D, I, S, C), communication Do's/Don'ts coach & tailored pitch generator.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CrystalPersona \u2014 DISC Buyer Personality & Pitch Coach",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "crystalpersona@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}
