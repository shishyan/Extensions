{
  "manifest_version": 3,
  "name": "UberSuggest — Free Multi-Engine Keyword Multiplier, CPC & SEO Difficulty Scorer",
  "short_name": "UberSuggest",
  "version": "1.0.0",
  "description": "100% Free Ubersuggest Paid alternative: Multi-engine autocomplete keyword multiplier (Google, YouTube, Shopping, Questions), CPC ($) & SEO Difficulty (SD) scorer.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "UberSuggest — Keyword Multiplier & CPC/SD Scorer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://suggestqueries.google.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ubersuggest@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}
