{
  "manifest_version": 3,
  "name": "RefGitHub \u2014 Free 1-Click Code Block Copy Injector & Snippet Harvester",
  "short_name": "RefGitHub",
  "version": "1.0.0",
  "description": "100% Free Refined GitHub & Code Power Suite alternative: 1-click Copy Code button injector on all <pre>/<code> blocks, LOC counter & full-page snippet harvester.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RefGitHub \u2014 Code Copy Injector & Snippet Harvester",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "refgithub@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}