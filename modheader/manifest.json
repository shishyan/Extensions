{
  "manifest_version": 3,
  "name": "ModHeader \u2014 Free HTTP Request/Response Header Studio & cURL Generator",
  "short_name": "ModHeader",
  "version": "1.0.0",
  "description": "100% Free ModHeader Pro alternative: Zero-ad custom HTTP header profile manager, CORS/CSP security header auditor & 1-click cURL...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ModHeader \u2014 Custom Header Profiles & cURL Generator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}