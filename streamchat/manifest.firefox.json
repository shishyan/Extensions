{
  "manifest_version": 3,
  "name": "StreamChat \u2014 Free Live Chat Q&A Filter, Spam Blocker & Cinema Mode",
  "short_name": "StreamChat",
  "version": "1.0.0",
  "description": "100% Free 7TV & BetterTTV Pro alternative: Live stream chat viewer question extractor, duplicate spam filter, MPM velocity meter & Cinema Theater Mode.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StreamChat \u2014 Live Stream Q&A Filter & Cinema Enhancer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "streamchat@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}
