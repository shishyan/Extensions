{
  "manifest_version": 3,
  "name": "DeepTranslate \u2014 Free Bilingual Selection Translator & Dual-Language Reader",
  "short_name": "DeepTranslate",
  "version": "1.0.0",
  "description": "100% Free DeepL Pro & Immersive Translate alternative: Instant selection tooltip translator, inline side-by-side bilingual...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeepTranslate \u2014 Bilingual Selection & Immersive Page Translator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://translate.googleapis.com/*"
  ]
}