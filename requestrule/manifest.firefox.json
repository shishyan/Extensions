{
  "manifest_version": 3,
  "name": "RequestRule \u2014 Free Network Timing Inspector, URL Rule & Mock Response Studio",
  "short_name": "RequestRule",
  "version": "1.0.0",
  "description": "100% Free Requestly Pro alternative: Live network resource timing inspector, URL redirect/parameter rule builder & JSON mock response studio.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RequestRule \u2014 Network Timing & HTTP Rule Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "requestrule@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}