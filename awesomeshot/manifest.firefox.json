{
  "manifest_version": 3,
  "name": "AwesomeShot \u2014 Free PII Blur Redactor, Callout Annotator & Screenshot Studio",
  "short_name": "AwesomeShot",
  "version": "1.0.0",
  "description": "100% Free Awesome Screenshot Pro alternative: 1-click PII/sensitive data blur tool, red callout box annotator & high-res annotated PNG capture.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AwesomeShot \u2014 PII Blur Redactor & Screenshot Annotator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "awesomeshot@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}
