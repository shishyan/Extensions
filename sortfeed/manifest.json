{
  "manifest_version": 3,
  "name": "SortFeed \u2014 Free Social & Video Feed Sorter by Views, Likes & Viral Ratio",
  "short_name": "SortFeed",
  "version": "1.0.0",
  "description": "100% Free SortFeed Paid alternative: Sort any social/video feed by Views, Likes, or Viral Outlier Multiplier in 1 click and export top performers to CSV.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SortFeed \u2014 Universal Feed Sorter & Viral Outlier Ranker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
