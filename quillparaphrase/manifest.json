{
  "manifest_version": 3,
  "name": "QuillParaphrase \u2014 Free AI Paraphraser, 5 Rewrite Modes & Synonym Slider",
  "short_name": "QuillParaphrase",
  "version": "1.0.0",
  "description": "100% Free QuillBot Premium alternative: Paraphrase sentences & paragraphs in 5 modes (Fluency, Formal, Academic, Concise,...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuillParaphrase \u2014 Free AI Paraphraser & Synonym Slider",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}