{
  "manifest_version": 3,
  "name": "RakuCash \u2014 Free Direct Deal Finder & Affiliate Tracking Link Stripper",
  "short_name": "RakuCash",
  "version": "1.0.0",
  "description": "100% Free Rakuten & Clean-Link alternative: 1-click affiliate tracking parameter stripper (utm_*, aff_id, clickid, tag), direct...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RakuCash \u2014 Direct Deals & Affiliate Link Cleaner",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}