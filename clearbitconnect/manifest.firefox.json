{
  "manifest_version": 3,
  "name": "ClearbitConnect \u2014 Free B2B Firmographics, Tech Stack & Domain Intelligence",
  "short_name": "ClearbitConnect",
  "version": "1.0.0",
  "description": "100% Free Clearbit Connect Pro alternative: Instant B2B company firmographics inspector, industry classifier, headcount estimator & email provider lookup.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClearbitConnect \u2014 B2B Firmographics & Domain Inspector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "clearbitconnect@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}
