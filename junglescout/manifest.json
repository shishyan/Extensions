{
  "manifest_version": 3,
  "name": "JungleScout \u2014 Free E-Commerce Sales Estimator, FBA Profit & LQS Auditor",
  "short_name": "JungleScout",
  "version": "1.0.0",
  "description": "100% Free Jungle Scout alternative: Amazon & E-Commerce BSR-to-Monthly-Sales estimator, FBA Net Profit & ROI calculator, and Listing Quality Score (LQS).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JungleScout \u2014 Sales Estimator & FBA Profit Calculator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
