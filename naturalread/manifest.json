{
  "manifest_version": 3,
  "name": "NaturalRead \u2014 Free Dyslexia Reading Ruler, RSVP Speed Reader & TTS",
  "short_name": "NaturalRead",
  "version": "1.0.0",
  "description": "100% Free NaturalReader Plus alternative: Mouse-tracking ADHD/Dyslexia Focus Reading Ruler, 300\u2013900 WPM Spritz RSVP Speed Reader & voice narration.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NaturalRead \u2014 Focus Reading Ruler & RSVP Speed Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
