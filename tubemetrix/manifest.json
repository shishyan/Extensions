{
  "manifest_version": 3,
  "name": "TubeMetrix \u2014 Free YouTube SEO, Outlier Finder & Studio AI Suite",
  "short_name": "TubeMetrix",
  "version": "99.0.0",
  "description": "Surpasses vidIQ Max, TubeBuddy Legend & 1of10: Top-bar Live VPH, Search Keyword Inspector, 100-pt SEO Scorecard, Tag Generator, AI Title Studio & Thumbnail Downloader.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TubeMetrix \u2014 Free YouTube SEO & Outlier Suite",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*"
  ]
}