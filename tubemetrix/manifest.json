{
  "manifest_version": 3,
  "name": "TubeMetrix \u2014 Full YouTube SEO, Outlier, Competitor & Studio Suite",
  "short_name": "TubeMetrix",
  "version": "100.3.0",
  "description": "100% Free Full-Featured Replacement for vidIQ Max, TubeBuddy Legend & 1of10: Real SERP Keyword Engine, Tag Ranks, Outliers,...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TubeMetrix \u2014 YouTube Growth & Outlier Command Center",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://www.youtube.com/*",
    "https://studio.youtube.com/*",
    "https://i.ytimg.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "yt_api_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess"
  ]
}