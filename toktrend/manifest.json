{
  "manifest_version": 3,
  "name": "TokTrend \u2014 Free Short-Form Engagement Calculator, Trend Velocity & Hook Studio",
  "short_name": "TokTrend",
  "version": "1.0.0",
  "description": "100% Free Exolyt & Pentos alternative: Live short-form video Engagement Rate calculator, Viral Velocity HUD badge & 3-second Hook Script generator.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TokTrend \u2014 Short-Form Engagement & Viral Hook Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
