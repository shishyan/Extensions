{
  "manifest_version": 3,
  "name": "MoniAssistant \u2014 Free AI Sidebar, Page Q&A, Translator & Reply Drafter",
  "short_name": "MoniAssistant",
  "version": "1.0.0",
  "description": "100% Free Monica AI Pro alternative: Slide-out right sidebar (Alt+M) with Page Summary & Q&A, Selection Explainer/Translator,...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MoniAssistant \u2014 Free AI Sidebar, Translator & Reply Drafter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "moniassistant@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}