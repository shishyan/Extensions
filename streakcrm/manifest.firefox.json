{
  "manifest_version": 3,
  "name": "StreakCRM \u2014 Free In-Browser Kanban Deal Pipeline & Contact CRM",
  "short_name": "StreakCRM",
  "version": "1.0.0",
  "description": "100% Free Streak CRM Pro alternative: In-browser Kanban deal pipeline (Lead -> Contacted -> Demo -> Proposal -> Won), deal value...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "StreakCRM \u2014 Kanban Deal Pipeline & Contact CRM",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "streakcrm@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}