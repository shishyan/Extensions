{
  "manifest_version": 3,
  "name": "KoalaShop \u2014 Free Shopify & D2C Store Theme, App & Best-Seller Inspector",
  "short_name": "KoalaShop",
  "version": "1.0.0",
  "description": "100% Free Koala Inspector Pro alternative: Detect Shopify/D2C store themes, installed apps (Klaviyo, Loox, Judge.me), pricing matrix & best-selling products.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "KoalaShop \u2014 Shopify & D2C Store Theme & App Inspector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
