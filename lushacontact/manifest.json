{
  "manifest_version": 3,
  "name": "LushaContact \u2014 Free Direct-Dial Phone, Email & vCard (.VCF) Finder",
  "short_name": "LushaContact",
  "version": "1.0.0",
  "description": "100% Free Lusha Pro alternative: Unmask direct-dial phone numbers (E.164), corporate emails & export 1-click .VCF vCard contact...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LushaContact \u2014 Direct-Dial Phone & vCard Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}