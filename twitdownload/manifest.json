{
  "manifest_version": 3,
  "name": "TwitDownload \u2014 Free Thread-to-Markdown Unroller & Social Media Harvester",
  "short_name": "TwitDownload",
  "version": "1.0.0",
  "description": "100% Free X/Twitter & Reddit Thread/Media Saver alternative: 1-click thread-to-Markdown unroller, high-res image/video harvester...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TwitDownload \u2014 Thread Unroller & Social Media Harvester",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}