{
  "manifest_version": 3,
  "name": "AhrefBacklink \u2014 Free Anchor Text Analyzer, Outbound Link & 404 Broken Scanner",
  "short_name": "AhrefBacklink",
  "version": "1.0.0",
  "description": "100% Free Ahrefs SEO Toolbar alternative: Outbound & internal link analyzer, anchor text distribution table, 404 broken link scanner & CSV exporter.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AhrefBacklink \u2014 Anchor Text & Broken Link Scanner",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
