{
  "manifest_version": 3,
  "name": "HeliumSeller \u2014 Free Xray Product Scanner, ASIN Grabber & Keyword Extractor",
  "short_name": "HeliumSeller",
  "version": "1.0.0",
  "description": "100% Free Helium 10 alternative: Xray product grid scanner, ASIN/SKU grabber, Review Velocity analyzer & high-converting Backend...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HeliumSeller \u2014 Xray Product Scanner & Keyword Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}