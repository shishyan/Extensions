{
  "manifest_version": 3,
  "name": "SemRank \u2014 Free Technical SEO Diagnosis Bar, Schema Validator & N-Gram Matrix",
  "short_name": "SemRank",
  "version": "1.0.0",
  "description": "100% Free SEOquake Pro & SEMrush Toolbar alternative: Instant technical SEO diagnosis bar, JSON-LD Schema validator & 1/2/3-word...",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SemRank \u2014 Technical SEO Diagnosis & Keyword Density Matrix",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://suggestqueries.google.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "semrank@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}